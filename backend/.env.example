NODE_ENV=development
PORT=3000

# MySQL connection (use a dedicated user, never root)
DB_HOST=localhost
DB_PORT=3306
DB_USER=hostel_app
DB_PASSWORD=
DB_NAME=smart_hostel

# Auth: JWT_SECRET must be 32+ random characters
JWT_SECRET=
JWT_EXPIRES_HOURS=8

# NEXORA main portal: bcrypt hash for the shared portal password (generate locally)
PORTAL_PASSWORD_HASH=
PORTAL_SESSION_HOURS=8

# Shared secret that biometric devices send in the x-device-key header (16+ chars)
DEVICE_API_KEY=

# First admin (Chairman) account created by "npm run setup"
ADMIN_USERNAME=chairman
ADMIN_PASSWORD=
ADMIN_NAME=Chairman

# Password for demo accounts created by "npm run seed:demo" (8+ chars, letter + digit)
DEMO_PASSWORD=

# Set to 1 when running behind a reverse proxy (HTTPS in production)
TRUST_PROXY=0
